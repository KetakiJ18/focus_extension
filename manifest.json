{
    "manifest_version": 3,
    "name": "Focus Companion",
    "version": "1.0",
    "description": "Reduce distractions and boost focus",
    "permissions": ["storage", "tabs", "activeTab"],
    "host_permissions": ["<all_urls>"],
    
    "chrome_url_overrides": {
    "newtab": "newtab.html"
    },

    "background": {
        "service_worker": "background.js"
    },

    "action": {
        "default_popup": "popup/popup.html"
    },

    "content_scripts": [
        {
        "matches": ["<all_urls>"],
        "js": ["content.js"],
        "css": ["styles/overlay.css"]
        }
    ]

}